CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=1024
# The QSPI DMA/LCD and audio paths need internal RAM, but reserving 100 KiB
# left no allocatable internal block for the BLE controller after Wi-Fi AP
# startup.  64 KiB still covers the 51 KiB LCD DMA buffer plus audio DMA.
# BLE is initialized before Wi-Fi and therefore receives its contiguous
# controller allocation first.  Keep only the DMA working set internal so
# generic allocations move to PSRAM before the Wi-Fi driver reserves its RX
# buffers.  48 KiB still left the third 1.6 KiB RX buffer unavailable on this
# ESP32-S3 N16R8; 32 KiB provides both controllers their required space.
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# The ESP32-S3 must run the BLE WazeMod transport and Wi-Fi together.  The
# Wi-Fi driver was configured for three static RX buffers but could allocate
# only two after BLE had reserved its controller pool, causing startup to
# abort.  Two is the supported minimum and is sufficient for provisioning and
# the low-rate Xiaozhi control/audio traffic.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=2
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_ESP_WIFI_RX_BA_WIN=3
# The Wi-Fi provisioning AP shares the internal heap with the ST77922 DMA,
# ES8311 audio path and NimBLE Waze transport.  ESP-IDF defaults its dynamic
# TX and management-short pools to 32 entries; on this board that leaves the
# SoftAP beacon allocation without a contiguous block and the Wi-Fi library
# subsequently panics.  The HUD only needs low-rate configuration/control
# traffic, so use the documented minima-compatible bounded pools.
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=2
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=4
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=6
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=16
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

# Use an internal DMA bounce buffer so incomplete RGB frames can be rejected.
# Limit its size to preserve internal heap for AFE and WakeNet.
CONFIG_CAMERA_PSRAM_DMA=n
CONFIG_CAMERA_DMA_BUFFER_SIZE_MAX=16384

CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

CONFIG_USB_HOST_CONTROL_TRANSFER_MAX_SIZE=1536

# LVGL Graphics
CONFIG_LV_USE_SNAPSHOT=y
# Builtin TLSF pool in PSRAM (lvgl_psram_pool.h). Keep the base pool small
# enough for 2MB PSRAM boards; 8MB boards add extra pools in lcd_display.cc
# (chunked to LV_MEM_SIZE — TLSF rejects a single add_pool larger than this).
# Variants that set CONFIG_SPIRAM=n are switched back to CLIB malloc in
# scripts/build.py; do not repeat that override on each board.
CONFIG_LV_USE_BUILTIN_MALLOC=y
# CONFIG_LV_USE_CLIB_MALLOC is not set
CONFIG_LV_MEM_SIZE_KILOBYTES=1024
