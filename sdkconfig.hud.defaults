CONFIG_BOARD_TYPE_LCDWIKI_ES3C35P=y
CONFIG_LANGUAGE_VI_VN=y
CONFIG_WAZE_HUD_AI=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_CONTROLLER_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MAX_BONDS=3
# WazeMod HLP/1 uses one connection. Two controller activities allow the
# advertising state and the one live link without the six-activity default.
# BLE_MASTER keeps the controller's connection support enabled; disabling it
# produced CONNECT:0 and a controller allocation/assert during initialization.
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_BLE_MASTER=y
CONFIG_BT_CTRL_BLE_SCAN=n
CONFIG_BT_CTRL_BLE_SECURITY_ENABLE=n
CONFIG_USE_HOTSPOT_WIFI_PROVISIONING=y
CONFIG_USE_ESP_BLUFI_WIFI_PROVISIONING=n
CONFIG_WAKE_WORD_DISABLED=y
CONFIG_USE_AFE_WAKE_WORD=n
CONFIG_USE_CUSTOM_WAKE_WORD=n
CONFIG_USE_AUDIO_PROCESSOR=y
CONFIG_USE_DEVICE_AEC=n
CONFIG_USE_SERVER_AEC=n
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=n
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
